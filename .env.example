# Newsletter. Set these as function environment variables on Netlify.
# Also include NEWSLETTER_SIGNUP_ENABLED in the build scope to show the form.
NEWSLETTER_SIGNUP_ENABLED=false
RESEND_CONTACTS_API_KEY=
RESEND_SEGMENT_ID=
RESEND_FROM="The Monthly Diff <newsletter@example.com>"
RESEND_REPLY_TO=
NEWSLETTER_LINK_SECRET=

# Optional sending-only key for welcome mail, required by email:test.
RESEND_API_KEY=
# Bare sender address for email:test.
RESEND_FROM_EMAIL=

# Optional local override for links when running netlify dev on a different port.
# NEWSLETTER_LOCAL_ORIGIN=http://127.0.0.1:8888

{
  "name": "monthlydiff.com",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.tsx",
    "email:preview": "tsx scripts/preview-email.ts",
    "email:broadcast": "tsx --env-file-if-exists=.env.local scripts/create-issue-broadcast.ts",
    "email:test": "tsx --env-file-if-exists=.env.local scripts/send-test-email.ts",
    "triage": "node backend/build-board.mjs && node backend/server.mjs",
    "triage:install": "node backend/build-board.mjs && node backend/launch-agents.mjs install",
    "triage:stop": "node backend/launch-agents.mjs stop",
    "triage:sync": "node backend/collect.mjs",
    "triage:test": "node --test backend/backend.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FullStackCraft/monthlydiff.com.git"
  },
  "private": true,
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@netlify/blobs": "^11.1.9",
    "@netlify/functions": "^6.1.1",
    "markdown-to-jsx": "^9.10.6",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.14",
    "resend": "^6.38.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@next/eslint-plugin-next": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "fast-xml-parser": "^5.5.10",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
